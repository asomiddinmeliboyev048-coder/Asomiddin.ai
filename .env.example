# Supabase (required for persistent user data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LMS worker: set on Render, not in the browser
SUPABASE_URL=
AI_OWNER_ID=primary
LMS_DATA_DIR=/data
LMS_SYNC_INTERVAL_MS=21600000

# Voice provider credentials (configure after choosing provider)
VOICE_PROVIDER=
VOICE_API_KEY=

# Telephony provider (optional; requires supported number/routing)
TELEPHONY_PROVIDER=
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=

# Internal API protection
INTERNAL_API_SECRET=
